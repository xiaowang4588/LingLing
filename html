  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/FileSaver.js/2.0.5/FileSaver.min.js"></script>

  <script>
    const drop = document.getElementById('giffj_drop');
    const fileInput = document.getElementById('giffj_file');
    const btnSelect = document.getElementById('giffj_btn_select');
    const btnStart = document.getElementById('giffj_btn_start');
    const btnDownload = document.getElementById('giffj_btn_download');
    const previewArea = document.getElementById('giffj_preview_area');
    const results = document.getElementById('giffj_results');

    let currentGif = null;

    function resetState(){
      // 撤销所有已创建的对象 URL，以避免内存泄漏
      if(currentGif && currentGif.frames){
        currentGif.frames.forEach(f=>{ try{ URL.revokeObjectURL(f.url); }catch(e){} });
      }
      currentGif = null;
      previewArea.innerHTML = '<div class="giffj_hint">当前没有 GIF</div>';
      results.innerHTML = '';
      btnStart.disabled = true;
      btnDownload.disabled = true;
    }

    resetState();

    ;['dragenter','dragover'].forEach(e => drop.addEventListener(e, ev => {ev.preventDefault();drop.classList.add('giffj_dragover');}))
    ;['dragleave','drop'].forEach(e => drop.addEventListener(e, ev => {ev.preventDefault();drop.classList.remove('giffj_dragover');}))

    drop.addEventListener('drop', ev => {
      const f = ev.dataTransfer.files && ev.dataTransfer.files[0];
      if(f) handleFile(f);
    });

    drop.addEventListener('click', ()=> fileInput.click());
    btnSelect.addEventListener('click', ()=> fileInput.click());
    fileInput.addEventListener('change', e => { if(e.target.files[0]) handleFile(e.target.files[0]); });

    async function handleFile(file){
      if(!file.type.includes('gif')){ alert('请上传 GIF 文件'); return; }
      const ab = await file.arrayBuffer();

      if(currentGif && currentGif.frames){
        currentGif.frames.forEach(f=>{ try{ URL.revokeObjectURL(f.url); }catch(e){} });
      }
      currentGif = { blob: file, arrayBuffer: ab, frames: [] };

      // 预览
      previewArea.innerHTML = '';
      const img = document.createElement('img');
      img.src = URL.createObjectURL(file);
      img.alt = 'gif';
      img.style.maxHeight = '260px';
      previewArea.appendChild(img);

      btnStart.disabled = false;
      results.innerHTML = '';
      btnDownload.disabled = true;
    }

    // 使用 ImageDecoder 进行分解
    async function decomposeWithImageDecoder(){
      try{
        if(!window.ImageDecoder){
          throw new Error('浏览器不支持 ImageDecoder，请使用最新版 Chrome 或 Edge 浏览器');
        }

        // 优先使用 Uint8Array (BufferSource)
        let initData;
        try{
          initData = new Uint8Array(currentGif.arrayBuffer);
        }catch(e){
          // 如果 Uint8Array 构造失败，则回退到原始 ArrayBuffer
          initData = currentGif.arrayBuffer;
        }

        let decoder;
        try{
          decoder = new ImageDecoder({data: initData, type: 'image/gif'});
        }catch(err){
          // 尝试传递 Blob
          try{
            const blob = new Blob([currentGif.arrayBuffer], {type: 'image/gif'});
            decoder = new ImageDecoder({data: blob, type: 'image/gif'});
          }catch(err2){
            throw err;
          }
        }

        // 等待曲目元数据
        await decoder.tracks.ready;

        // 尝试从轨道元数据中读取帧数
        let frameCount;
        try{
          const track = decoder.tracks.selectedTrack || decoder.tracks[0];
          if(track && typeof track.frameCount === 'number') frameCount = track.frameCount;
        }catch(e){ /* ignore */ }

        let index = 0;
        const MAX_FRAMES = 2000;

        while(true){
          if(typeof frameCount === 'number' && index >= frameCount) break;
          if(index >= MAX_FRAMES) break;
          try{
            const result = await decoder.decode({frameIndex: index});
            const imageLike = result.image;

            // 绘制到画布
            let bitmap = imageLike;
            let createdBitmap = false;
            if(typeof VideoFrame !== 'undefined' && imageLike instanceof VideoFrame){
              bitmap = await createImageBitmap(imageLike);
              createdBitmap = true;
            }else if(!(typeof ImageBitmap !== 'undefined' && imageLike instanceof ImageBitmap)){
              bitmap = await createImageBitmap(imageLike);
              createdBitmap = true;
            }

            const canvas = document.createElement('canvas');
            canvas.width = bitmap.width;
            canvas.height = bitmap.height;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(bitmap,0,0);
            const blobJpg = await new Promise(res => canvas.toBlob(res,'image/jpeg',0.92));
            const url = URL.createObjectURL(blobJpg);
            currentGif.frames.push({blob: blobJpg, url, index});

            // 关闭资源
            try{ if(imageLike && typeof imageLike.close === 'function') imageLike.close(); }catch(e){}
            try{ if(createdBitmap && bitmap && typeof bitmap.close === 'function') bitmap.close(); }catch(e){}

            index++;
          }catch(err){
            // 解码错误或超出范围的帧索引时停止
            break;
          }
        }

        try{ if(decoder && typeof decoder.close === 'function') decoder.close(); }catch(e){}

        if(currentGif.frames.length===0) throw new Error('没有解析出任何帧');
        return currentGif.frames;
      }catch(err){
        console.error('ImageDecoder 解析失败：', err);
        throw err;
      }
    }

    async function doDecompose(){
      btnStart.disabled = true;
      btnStart.textContent = '处理中...';
      results.innerHTML = '';
      currentGif.frames = [];
      try{
        await decomposeWithImageDecoder();
        renderResults();
        btnDownload.disabled = false;
      }catch(err){
        alert('分解失败：'+err.message+'。请更换 Chrome、Edge 浏览器最新版本再使用。');
        console.error(err);
      }finally{
        btnStart.disabled = false;
        btnStart.textContent = '开始分解';
      }
    }

    function renderResults(){
      results.innerHTML = '';
      currentGif.frames.forEach((f, i) => {
        const box = document.createElement('div'); box.className = 'giffj_frame';
        const im = document.createElement('img'); im.src = f.url; im.alt = `frame-${i}`;
        const meta = document.createElement('div'); meta.className='giffj_meta'; meta.textContent = `帧 ${i+1}`;
        const dl = document.createElement('button'); dl.className='giffj_btn secondary'; dl.textContent='下载';
        dl.addEventListener('click', ()=>{
          const a = document.createElement('a'); a.href = f.url; a.download = `frame-${String(i+1).padStart(3,'0')}.jpg`; document.body.appendChild(a); a.click(); a.remove();
        });
        box.appendChild(im); box.appendChild(meta); box.appendChild(dl);
        results.appendChild(box);
      });
    }

    btnStart.addEventListener('click', async ()=>{
      if(!currentGif) return;
      await doDecompose();
    });

    btnDownload.addEventListener('click', async ()=>{
      if(!currentGif || !currentGif.frames || currentGif.frames.length===0) return;
      btnDownload.disabled = true; btnDownload.textContent='生成 ZIP...';
      try{
        if(typeof JSZip === 'undefined') throw new Error('JSZip 未加载');
        const zip = new JSZip();
        const folder = zip.folder('frames');
        currentGif.frames.forEach((f,i)=>{
          folder.file(`frame-${String(i+1).padStart(3,'0')}.jpg`, f.blob);
        });
        const content = await zip.generateAsync({type:'blob'});
        saveAs(content, 'gif-frames.zip');
      }catch(err){
        alert('打包失败：'+err.message);
      }finally{
        btnDownload.disabled = false; btnDownload.textContent='批量下载（ZIP）';
      }
    });
  </script>
</body>
