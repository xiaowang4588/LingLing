            method: 'POST',
            body: formData
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
            if (data && data.success && data.data) {
                container.dataset.challengeId = data.data.challenge_id || '';
                container.dataset.challengeSignature = data.data.challenge_signature || '';
                container.dataset.challengeIssued = String(data.data.challenge_issued || '');
            }
        })
        .catch(function() {});
    }

    function initModalCaptcha(container, verifiedInputId) {
        var slider = container.querySelector('.captcha-slider');
        var progress = container.querySelector('.captcha-progress');
        var text = container.querySelector('.captcha-text');
        var track = container.querySelector('.captcha-track');
        var verified = document.getElementById(verifiedInputId);
        
        if (!slider || !track || !verified) return;

        if (isAliyunCaptchaProvider()) {
            window.DSProviderCaptcha.attachAliyunCaptcha(container, {
                verifiedInput: verified,
                sceneType: 'auth',
                nonceGetter: getModalAuthNonce,
                waitingText: '点击完成验证',
                buttonText: '点击验证',
                verifyingText: '正在验证...',
                successText: '验证成功',
                failedText: '验证失败，请重试',
                configErrorText: '验证码配置不完整，请联系管理员'
            });
            return;
        }
        
        var isDragging = false;
        var hasMoved = false;
        var startX = 0;
        var sliderLeft = 0;
        var sliderWidth = 44;
        var trackWidth = 0;
        var dragStartedAt = 0;
        var moveCount = 0;
        var maxLeft = 0;
        
        function updateTrackWidth() {
            trackWidth = track.offsetWidth - sliderWidth;
        }
        
        function getClientX(e) {
            return e.touches ? e.touches[0].clientX : e.clientX;
        }
        
        function handleStart(e) {
            if (verified.value && verified.value !== 'false') return;
            
            updateTrackWidth();
            isDragging = true;
            hasMoved = false;
            startX = getClientX(e);
            sliderLeft = parseInt(slider.style.left) || 0;
            dragStartedAt = Date.now();
            moveCount = 0;
            maxLeft = sliderLeft;
            
            slider.style.transition = 'none';
            progress.style.transition = 'none';
            
            e.preventDefault();
        }
        
        function handleMove(e) {
            if (!isDragging) return;
            
            var clientX = getClientX(e);
            var deltaX = clientX - startX;
            var newLeft = Math.max(0, Math.min(sliderLeft + deltaX, trackWidth));
            
            if (Math.abs(deltaX) > 5) {
                hasMoved = true;
            }
            moveCount++;
            if (newLeft > maxLeft) {
                maxLeft = newLeft;
            }
            
            slider.style.left = newLeft + 'px';
            progress.style.width = (newLeft + sliderWidth) + 'px';
            
            e.preventDefault();
        }
        
        function handleEnd() {
            if (!isDragging) return;
            isDragging = false;
            
            slider.style.transition = 'left 0.3s';
            progress.style.transition = 'width 0.3s';
            
            var currentLeft = parseInt(slider.style.left) || 0;
            
            if (hasMoved && currentLeft >= trackWidth - 5 && trackWidth > 0) {
                var challengeId = container.dataset.challengeId || '';
                var challengeSignature = container.dataset.challengeSignature || '';
                var challengeIssued = container.dataset.challengeIssued || '';
                if (!challengeId || !challengeSignature || !challengeIssued) {
                    text.textContent = '验证初始化失败，请重试';
                    setTimeout(function() {
                        resetModalCaptcha(container.id, verifiedInputId);
                    }, 500);
                    return;
                }

                // 向服务器请求验证token
                text.textContent = '正在验证...';
                slider.style.pointerEvents = 'none';
                
                var formData = new FormData();
                formData.append('action', 'developer_starter_captcha_verify');
                formData.append('nonce', getModalAuthNonce());
                formData.append('challenge_id', challengeId);
                formData.append('challenge_signature', challengeSignature);
                formData.append('challenge_issued', challengeIssued);
                formData.append('drag_duration', String(Math.max(0, Date.now() - dragStartedAt)));
                formData.append('move_count', String(moveCount));
                formData.append('drag_distance', String(Math.max(currentLeft, maxLeft)));
                
                fetch('https://www.wujiit.com/wp-admin/admin-ajax.php', {
                    method: 'POST',
                    body: formData
                })
                .then(function(res) { return res.json(); })
                .then(function(data) {
                    if (data.success) {
                        verified.value = data.data.token;
                        container.classList.add('verified');
                        text.textContent = '验证成功';
                        slider.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>';
                    } else {
                        text.textContent = '验证失败，请重试';
                        setTimeout(function() {
                            resetModalCaptcha(container.id, verifiedInputId);
                        }, 1000);
                    }
                })
                .catch(function() {
                    text.textContent = '网络错误';
                    setTimeout(function() {
                        resetModalCaptcha(container.id, verifiedInputId);
                    }, 1000);
                });
            } else {
                slider.style.left = '0';
                progress.style.width = sliderWidth + 'px';
            }
        }
        
        slider.addEventListener('mousedown', handleStart);
        document.addEventListener('mousemove', handleMove);
        document.addEventListener('mouseup', handleEnd);
        slider.addEventListener('touchstart', handleStart, { passive: false });
        document.addEventListener('touchmove', handleMove, { passive: false });
        document.addEventListener('touchend', handleEnd);

        requestModalCaptchaChallenge(container);
    }

    function resetModalCaptcha(containerId, verifiedInputId) {
        var container = document.getElementById(containerId);
        var verified = document.getElementById(verifiedInputId);
        if (!container || !verified) return;
        if (isAliyunCaptchaProvider()) {
            window.DSProviderCaptcha.resetContainer(container, verified);
            return;
        }
        var slider = container.querySelector('.captcha-slider');
        var progress = container.querySelector('.captcha-progress');
        var text = container.querySelector('.captcha-text');
        if (!slider || !progress || !text) return;
        verified.value = 'false';
        container.classList.remove('verified');
        slider.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>';
        slider.style.pointerEvents = 'auto';
        slider.style.left = '0';
        progress.style.width = slider.offsetWidth + 'px';
        text.textContent = '向右滑动验证';
        container.dataset.challengeId = '';
        container.dataset.challengeSignature = '';
        container.dataset.challengeIssued = '';
        requestModalCaptchaChallenge(container);
    }
    </script>
