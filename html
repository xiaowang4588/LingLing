  <style>
    :root{
      --giffj-bg:#0f1724;
      --giffj-surface:#0b1220;
      --giffj-accent:#7c5cff;
      --giffj-accent-2:#26d0ce;
      --giffj-card:#0f1728;
      --giffj-text:#e6eef8;
      --giffj-muted:#98a0b3;
      --giffj-radius:14px;
    }

    html,body{height:100%;margin:0;font-family:Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; background:linear-gradient(180deg,var(--giffj-bg),#071024 60%); color:var(--giffj-text);}

    .giffj_container{max-width:980px;margin:32px auto;padding:20px;border-radius:18px;background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));box-shadow:0 8px 30px rgba(2,6,23,0.6);}

    .giffj_header{display:flex;align-items:center;gap:16px;margin-top:25px;}
    .giffj_title{font-size:22px;font-weight:700;letter-spacing:-0.3px}
    .giffj_sub{color:var(--giffj-muted);font-size:13px}

    /* 上传 */
    .giffj_uploader{margin-top:18px;display:grid;grid-template-columns:1fr 360px;gap:18px}

    .giffj_card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));padding:18px;border-radius:var(--giffj-radius);box-shadow:inset 0 1px 0 rgba(255,255,255,0.02);}    

    .giffj_drop{min-height:220px;border:2px dashed rgba(124,92,255,0.18);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;padding:18px;border-radius:12px;transition:all .18s}
    .giffj_drop.giffj_dragover{background:linear-gradient(180deg, rgba(124,92,255,0.04), rgba(38,208,206,0.03));transform:translateY(-4px);border-color:rgba(38,208,206,0.28)}
    .giffj_icon{width:56px;height:56px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(135deg,var(--giffj-accent),var(--giffj-accent-2));box-shadow:0 10px 25px rgba(124,92,255,0.12);font-weight:700}
    .giffj_hint{color:var(--giffj-muted);font-size:13px}

    .giffj_preview{display:flex;flex-direction:column;gap:10px}
    .giffj_preview img{max-width:100%;border-radius:10px;box-shadow:0 8px 30px rgba(2,6,23,0.6)}

    .giffj_actions{display:flex;gap:10px;flex-wrap:wrap}
    .giffj_btn{background:linear-gradient(90deg,var(--giffj-accent),var(--giffj-accent-2));color:#02121a;padding:10px 14px;border-radius:12px;border:none;font-weight:600;cursor:pointer}
    .giffj_btn.secondary{background:transparent;color:var(--giffj-text);border:1px solid rgba(255,255,255,0.06)}
    .giffj_btn:disabled{opacity:.45;cursor:not-allowed}

    /* 结果 */
    .giffj_results{margin-top:18px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
    .giffj_frame{background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.02));padding:8px;border-radius:10px;display:flex;flex-direction:column;align-items:center;gap:8px}
    .giffj_frame img{width:100%;height:160px;object-fit:cover;border-radius:8px}
    .giffj_frame .giffj_meta{font-size:12px;color:var(--giffj-muted)}

    .giffj_footer{margin-top:22px;padding:14px;border-radius:12px;background:linear-gradient(180deg, rgba(255,255,255,0.01), rgba(255,255,255,0.005));display:flex;flex-direction:column;gap:8px}

    /* 手机 */
    @media (max-width:880px){
      .giffj_uploader{grid-template-columns:1fr}
      .giffj_results{grid-template-columns:repeat(2,1fr)}
      .giffj_frame img{height:120px}
    }
    @media (max-width:480px){
      .giffj_results{grid-template-columns:1fr}
    }
  </style>
